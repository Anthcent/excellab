# Copy to .env and edit. Used by docker-compose.yml; `npm run dev` needs none of this.

# --- Postgres (docker compose) ---
POSTGRES_USER=excellab
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=excellab

# --- App ---
# Staff account created on the first boot (ADMIN_PASSWORD is required in production, min 8 characters).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-too

# Cookies are sent over HTTPS only. Set to false ONLY if you serve the site over plain http (no TLS).
COOKIE_SECURE=true

# Public URL of the site (optional). Same-host requests are always allowed; this adds one more allowed origin.
# PUBLIC_ORIGIN=https://gridlab.example.com

# Host port published by docker compose.
APP_PORT=3000

# Create the demo exam with 4 exercises on the first boot (once). Set to false to skip.
SEED_DEMO=true

# SESSION_TTL_DAYS=30

# --- Local development (no docker) ---
# Leave DATABASE_URL empty to use the embedded database (PGlite) stored in PGLITE_DIR.
# DATABASE_URL=postgres://user:password@localhost:5432/excellab
# PGLITE_DIR=./data/pglite
